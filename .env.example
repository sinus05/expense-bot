# Telegram bot token from @BotFather
BOT_TOKEN=

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Optional: name of the direct-expenses tab (defaults to "Expenses")
GOOGLE_SHEET_TAB=Expenses

# Paste the ENTIRE service account JSON key as one single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Access control ---

# Comma-separated Telegram numeric IDs that are always treated as approved
# admins — they skip registration entirely and are the only ones who can
# tap Approve/Deny on new registration requests. Get your own ID by
# messaging the bot /getid (works even before you're registered).
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Telegram chat ID that receives new registration requests (with
# Approve/Deny buttons) and stale-wallet alerts. Send /getid to the bot
# from the chat you want these in, then paste the number here.
ALERT_CHAT_ID=

# --- Wallet controls ---

# How many hours a wallet can hold cash (since its last activity) before
# it's flagged as stale/overdue.
OVERDUE_HOURS=24

# Minimum hours between repeat alerts for the same still-stale wallet.
REFLAG_HOURS=24

# Set automatically by Vercel when you enable Cron Jobs — you don't need to
# set this yourself, it's listed here just so you know it exists.
# CRON_SECRET=
