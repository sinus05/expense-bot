# Telegram bot token from @BotFather
BOT_TOKEN=

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Optional: name of the direct-expenses tab (defaults to "Expenses")
GOOGLE_SHEET_TAB=Expenses

# Paste the ENTIRE service account JSON key as one single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Cash advance controls ---

# Telegram chat ID to receive overdue-advance alerts. Send /getid to the bot
# from the chat you want alerts in, then paste the number here.
ALERT_CHAT_ID=

# How many hours an advance can stay open before it's flagged as overdue.
OVERDUE_HOURS=24

# Minimum hours between repeat alerts for the same still-open advance.
REFLAG_HOURS=24

# Any settlement gap larger than this (in UZS) is flagged as a discrepancy.
DISCREPANCY_TOLERANCE=2000

# Set automatically by Vercel when you enable Cron Jobs — you don't need to
# set this yourself, it's listed here just so you know it exists.
# CRON_SECRET=
